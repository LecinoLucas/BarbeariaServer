NODE_ENV=development
PORT=3333
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/alphamen_barbearia?schema=public"
CLIENT_URL=http://localhost:5173
# Provider de e-mail. Comece com resend.
EMAIL_PROVIDER=resend
# Trava global para envio real. Em desenvolvimento/teste pode ficar false.
EMAIL_ENABLED=false
# Nunca compartilhe a API key. Só preencha em ambiente controlado.
RESEND_API_KEY=
# Endereço remetente validado no provider.
EMAIL_FROM=
# Endereço opcional para respostas.
EMAIL_REPLY_TO=
# URL pública usada em links dos e-mails.
APP_PUBLIC_URL=http://localhost:5173
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_DEV=3000
API_RATE_LIMIT_MAX_PROD=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_DEV=100
LOGIN_RATE_LIMIT_MAX_PROD=10
DEV_ADMIN_NAME=Administrador
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_DEFAULT_PASSWORD=
DEV_PROFESSIONAL_NAME=Profissional AlphaMen
DEV_PROFESSIONAL_EMAIL=profissional@alphamen.com
DEV_PROFESSIONAL_PASSWORD=
DEV_CLIENT_NAME=Cliente AlphaMen
DEV_CLIENT_EMAIL=cliente@alphamen.com
DEV_CLIENT_PASSWORD=
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
RUN_SEED_ON_DEV_FULL=false
